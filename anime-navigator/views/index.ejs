<%- include('partials/header') %>

<h2>Список аниме</h2>

<!-- Фильтрация и сортировка -->
<form method="GET" action="/" style="margin-bottom: 20px;">
    <input type="text" name="search" placeholder="Поиск по названию..." value="<%= currentSearch %>">
    
    <select name="filterGenre">
        <option value="all" <%= currentGenre === 'all' ? 'selected' : '' %>>Все жанры</option>
        <% genres.forEach(genre => { %>
            <option value="<%= genre %>" <%= currentGenre === genre ? 'selected' : '' %>><%= genre %></option>
        <% }) %>
    </select>
    
    <select name="sort">
        <option value="">По умолчанию</option>
        <option value="title" <%= currentSort === 'title' ? 'selected' : '' %>>По названию</option>
        <option value="year" <%= currentSort === 'year' ? 'selected' : '' %>>По году (новые)</option>
        <option value="rating" <%= currentSort === 'rating' ? 'selected' : '' %>>По рейтингу</option>
    </select>
    
    <button type="submit">Применить</button>
</form>

<table border="1" cellpadding="10" style="width:100%; border-collapse: collapse;">
    <thead>
        <tr>
            <th>ID</th><th>Название</th><th>Жанр</th><th>Серий</th><th>Год</th><th>Рейтинг</th><th>Студия</th><th>Изобр.</th><th>Действия</th>
        </tr>
    </thead>
    <tbody>
        <% animeList.forEach(anime => { %>
        <tr>
            <td><%= anime.id %></td>
            <td><strong><%= anime.title %></strong></td>
            <td><%= anime.genre %></td>
            <td><%= anime.episodes %></td>
            <td><%= anime.year %></td>
            <td>⭐ <%= anime.rating %></td>
            <td><%= anime.studio %></td>
            <td>
                <% if (anime.image) { %>
                    <img src="<%= anime.image %>" width="40">
                <% } else { %>—<% } %>
            </td>
            <td>
                <a href="/edit/<%= anime.id %>">✏️</a> |
                <form action="/delete/<%= anime.id %>" method="POST" style="display:inline;">
                    <button type="submit" onclick="return confirm('Удалить?')">🗑️</button>
                </form>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>

<%- include('partials/footer') %>